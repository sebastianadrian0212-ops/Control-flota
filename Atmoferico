<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reporte Atmosférico</title>
<style>
:root{--azul:#0b5cab;--amar:#f2c300;--tinta:#14213a;--fondo:#eef2f7;--card:#fff;--borde:#c9d3e0;--ok:#1b7f3b;--mal:#b3261e;--gris:#5b6778}
*{box-sizing:border-box}
body{margin:0;background:var(--fondo);color:var(--tinta);font:16px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;padding-bottom:40px}
header{background:var(--azul);color:#fff;padding:14px 16px;border-bottom:6px solid var(--amar)}
header h1{margin:0;font-size:20px}
header p{margin:2px 0 0;font-size:13px;opacity:.9}
main{max-width:560px;margin:0 auto;padding:12px}
section{background:var(--card);border:1px solid var(--borde);border-radius:10px;padding:12px;margin-bottom:12px}
h2{font-size:15px;margin:0 0 10px}
label{display:block;font-size:13px;color:var(--gris);margin:8px 0 3px}
input,select{width:100%;font:inherit;padding:11px;border:1px solid var(--borde);border-radius:8px;background:#fff;color:var(--tinta)}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.seg{display:flex;gap:6px}
.seg button{flex:1;font:inherit;padding:11px 4px;border:1px solid var(--borde);background:#fff;border-radius:8px;color:var(--tinta)}
.seg button.on{background:var(--azul);border-color:var(--azul);color:#fff;font-weight:600}
.seg.est button.on.R{background:var(--ok);border-color:var(--ok)}
.seg.est button.on.N{background:var(--mal);border-color:var(--mal)}
.seg.est button.on.X{background:var(--gris);border-color:var(--gris)}
.row{border:1px solid var(--borde);border-left:6px solid var(--ok);border-radius:8px;padding:10px;margin-bottom:10px}
.row.N{border-left-color:var(--mal)}.row.X{border-left-color:var(--gris)}
.rh{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;font-weight:600}
.del{border:0;background:none;color:var(--mal);font:inherit;padding:6px}
.add{width:100%;padding:12px;font:inherit;font-weight:600;border:2px dashed var(--azul);color:var(--azul);background:#fff;border-radius:8px}
.cnt{display:grid;grid-template-columns:1fr 1fr;gap:6px;text-align:center}
.cnt div{background:var(--fondo);border-radius:8px;padding:8px 2px;font-size:12px;color:var(--gris)}
.cnt b{display:block;font-size:24px;color:var(--tinta)}
.cnt .r b{color:var(--ok)}.cnt .n b{color:var(--mal)}
.chk{display:flex;gap:8px;align-items:center;margin:10px 0;font-size:14px}
.chk input{width:22px;height:22px}
pre{white-space:pre-wrap;word-wrap:break-word;background:#f7f9fc;border:1px solid var(--borde);border-radius:8px;padding:10px;font:14px/1.45 ui-monospace,Menlo,monospace;margin:0 0 10px}
.btn{display:block;width:100%;padding:14px;font:inherit;font-weight:700;border:0;border-radius:10px;margin-bottom:8px;color:#fff}
.wa{background:#1fa855}.cp{background:var(--azul)}.nw{background:#fff;color:var(--mal);border:1px solid var(--mal)}
.msg{font-size:13px;color:var(--ok);min-height:18px;text-align:center}
.nrow{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.nrow span{font-weight:600}.st{display:flex;gap:6px}.st button{width:48px;font:inherit;font-size:22px;border:1px solid var(--borde);background:#fff;border-radius:8px;color:var(--azul)}.st input{width:72px;text-align:center;font-size:20px;font-weight:700}.warn{font-size:13px;color:#8a5a00;background:#fff4d6;border-radius:8px;padding:0;margin-top:8px}.warn:not(:empty){padding:8px}.cnt{margin-bottom:6px}.foto{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:14px}.foto span{font-weight:600;width:100%}.fbtn{position:relative;overflow:hidden;flex:1;text-align:center;padding:14px 6px;border:2px dashed var(--azul);color:var(--azul);border-radius:8px;font-weight:600}.fbtn input{position:absolute;top:0;left:0;width:100%;height:100%;opacity:0;font-size:0;padding:0;border:0;cursor:pointer}.foto img{width:56px;height:56px;object-fit:cover;border-radius:6px}.hint{font-size:12px;color:var(--gris);margin:6px 0 0}
</style>
</head>
<body>
<header><h1>Reporte del camión atmosférico</h1><p>Se guarda en este teléfono. Cargá los números, copiá y mandá por WhatsApp.</p></header>
<main>
<section>
<h2>Datos del día</h2>
<div class="g2">
<div><label for="camion">Camión</label><input id="camion" placeholder="M3"></div>
<div><label for="cpc">CPC</label><select id="cpc"></select><input id="cpcOtro" placeholder="Nombre del CPC" style="margin-top:6px;display:none"></div>
</div>
<label>Turno</label>
<div class="seg" id="turno"><button data-v="TM">Mañana (TM)</button><button data-v="TT">Tarde (TT)</button></div>
<div class="g2">
<div><label for="litros">Litros extraídos</label><input id="litros" type="number" inputmode="numeric" placeholder="6000"></div>
<div><label for="descarga">Descarga en</label><input id="descarga" placeholder="Lugar"></div>
</div>
</section>

<section id="srv">
<h2>Servicios de la planilla</h2>
<div id="nums"></div>
<div class="cnt"><div class="n">No realizadas<b id="dN">0</b></div><div>Sin visitar<b id="dX">0</b></div></div>
<h2 style="margin-top:14px">Causa de los no realizados</h2>
<div id="causas"></div>
<input id="otroTxt" placeholder="Detalle de la otra causa" style="display:none;margin-top:6px">
<div class="warn" id="warn"></div>
<label for="barrios">Barrios (opcional)</label>
<input id="barrios" placeholder="Villa Azalais, Liceo III...">
</section>

<section>
<h2>Fotos</h2>
<div id="fotos"></div>
<div class="msg" id="fmsg"></div>
<p class="hint">Sacá la foto o elegila de la galería. Se mandan junto con el mensaje.</p>
</section>

<section>
<h2>Mensaje para WhatsApp</h2>
<pre id="out"></pre>
<button class="btn wa" id="wa">Enviar por WhatsApp</button>
<button class="btn cp" id="cp">Copiar mensaje</button>
<div class="msg" id="msg"></div>
<p class="hint">Si no cargaste fotos, adjuntalas después en el chat.</p>
</section>
<button class="btn nw" id="nw">Nuevo día (borrar números y litros)</button>
</main>

<script>
var KEY='reporte-atmosferico-v1';
var CPCS=['Centro América','Monseñor Pablo Cabrera','Argüello','Colón','Ruta 20','Villa El Libertador','Empalme','Pueyrredón','Rancagua','Mercado de la Ciudad','Guiñazú','San Vicente','Chalet San Felipe','Barrio Jardín','Capdevila','Mercantil','General Paz'];
var CAUSAS=['Sin moradores','Cámara sellada','Rechazó el servicio','Sin acceso','Otra causa'];
var S={camion:'M3',cpc:'Rancagua',cpcOtro:'',turno:'TM',litros:'',descarga:'',barrios:'',otroTxt:'',det:false,n:{P:0,V:0,R:0},c:[0,0,0,0,0]};
try{var g=localStorage.getItem(KEY);if(g)S=Object.assign(S,JSON.parse(g))}catch(e){}
if(!S.n||typeof S.n!=='object')S.n={P:0,V:0,R:0};
if(!Array.isArray(S.c)||S.c.length!==5)S.c=[0,0,0,0,0];
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
function $(i){return document.getElementById(i)}
function num(x){x=parseInt(x,10);return isNaN(x)||x<0?0:x}

function stepper(grp,k,label,val){
  return '<div class="nrow"><span>'+label+'</span><div class="st"><button type="button" data-g="'+grp+'" data-k="'+k+'" data-d="-1">&minus;</button>'
  +'<input type="number" inputmode="numeric" min="0" data-g="'+grp+'" data-k="'+k+'" value="'+val+'">'
  +'<button type="button" data-g="'+grp+'" data-k="'+k+'" data-d="1">+</button></div></div>';
}
$('nums').innerHTML=stepper('n','P','En planilla',S.n.P)+stepper('n','V','Visitadas',S.n.V)+stepper('n','R','Realizadas',S.n.R);
$('causas').innerHTML=CAUSAS.map(function(c,i){return stepper('c',i,c,S.c[i])}).join('');

function getv(g,k){return g==='n'?S.n[k]:S.c[k]}
function setv(g,k,v){if(g==='n')S.n[k]=v;else S.c[k]=v}
$('srv').addEventListener('click',function(e){
  var b=e.target.closest('button');if(!b||!b.dataset.d)return;
  var v=Math.max(0,num(getv(b.dataset.g,b.dataset.k))+(+b.dataset.d));
  setv(b.dataset.g,b.dataset.k,v);
  b.parentNode.querySelector('input').value=v;refresh();
});
$('srv').addEventListener('input',function(e){
  var t=e.target;if(!t.dataset||!t.dataset.g)return;
  setv(t.dataset.g,t.dataset.k,num(t.value));refresh();
});
$('srv').addEventListener('focusin',function(e){if(e.target.dataset&&e.target.dataset.g&&e.target.value==='0')e.target.select()});

function cpcName(){return S.cpc==='__otro'?S.cpcOtro:S.cpc}
function build(){
  var P=num(S.n.P),V=num(S.n.V),R=num(S.n.R);
  var N=Math.max(V-R,0),X=Math.max(P-V,0);
  $('dN').textContent=N;$('dX').textContent=X;
  var asign=S.c.reduce(function(a,b){return a+num(b)},0);
  $('otroTxt').style.display=num(S.c[4])>0?'block':'none';
  var w=[];
  if(V>P)w.push('Visitadas es mayor que en planilla.');
  if(R>V)w.push('Realizadas es mayor que visitadas.');
  if(N>0&&asign!==N)w.push('Causas cargadas: '+asign+' de '+N+' no realizadas.');
  if(N===0&&asign>0)w.push('Hay causas cargadas pero no hay no realizadas.');
  $('warn').textContent=w.join(' ');
  var L=['• '+(S.camion+' '+S.turno).trim(),'• CPC '+cpcName(),'• Planilla: '+P,'• Visitadas: '+V,'• Realizadas: '+R];
  if(N){
    var cs=[];
    S.c.forEach(function(n,i){n=num(n);if(n){var nm=i===4?(S.otroTxt||'otra causa'):CAUSAS[i].toLowerCase();cs.push(n+' '+nm)}});
    L.push('• No realizadas: '+N+(cs.length?' ('+cs.join(', ')+')':''));
  }
  if(X)L.push('• Sin visitar: '+X);
  L.push('• Litros extraídos: '+(S.litros||0)+' lt');
  if(S.descarga)L.push('• Descarga: '+S.descarga);
  if(S.barrios)L.push('• Barrios: '+S.barrios);
  var t=L.join('\n');
  $('out').textContent=t;return t;
}
function refresh(){save();build()}
function flash(m){$('msg').textContent=m;setTimeout(function(){$('msg').textContent=''},2500)}

var optH=CPCS.map(function(c,i){return '<option value="'+c+'">CPC '+(i+1)+' '+c+'</option>'}).join('')+'<option value="__otro">Otro CPC...</option>';
$('cpc').innerHTML=optH;
if(CPCS.indexOf(S.cpc)<0&&S.cpc!=='__otro'){S.cpcOtro=S.cpc;S.cpc='__otro'}
$('cpc').value=S.cpc;$('cpcOtro').value=S.cpcOtro;$('cpcOtro').style.display=S.cpc==='__otro'?'block':'none';
$('cpc').addEventListener('change',function(){S.cpc=this.value;$('cpcOtro').style.display=S.cpc==='__otro'?'block':'none';refresh()});
$('cpcOtro').addEventListener('input',function(){S.cpcOtro=this.value.trim();refresh()});
$('camion').value=S.camion;$('litros').value=S.litros;$('descarga').value=S.descarga;$('barrios').value=S.barrios;$('otroTxt').value=S.otroTxt;
function marcaTurno(){[].forEach.call($('turno').children,function(b){b.classList.toggle('on',b.dataset.v===S.turno)})}
['camion','litros','descarga','barrios','otroTxt'].forEach(function(id){$(id).addEventListener('input',function(){S[id]=this.value.trim();refresh()})});
$('turno').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;S.turno=b.dataset.v;marcaTurno();refresh()});
var FOTOS=[['plan','Planilla','planilla'],['cam','Camión','camion'],['desc','Descarga','descarga']];
var photos={};
function renderFotos(){
  $('fotos').innerHTML=FOTOS.map(function(f){
    var has=!!photos[f[0]];
    return '<div class="foto" data-k="'+f[0]+'"><span>'+f[1]+'</span><label class="fbtn">Cámara<input type="file" accept="image/*" capture="environment"></label><label class="fbtn">Galería<input type="file" accept="image/*"></label>'
    +(has?'<img alt="'+f[1]+'" src="'+URL.createObjectURL(photos[f[0]])+'"><button type="button" class="del">Quitar</button>':'')+'</div>';
  }).join('');
  var n=Object.keys(photos).length;
  $('wa').textContent=n?'Enviar por WhatsApp (con '+n+' foto'+(n>1?'s':'')+')':'Enviar por WhatsApp';
}
function comprimir(file,cb){
  var img=new Image(),u=URL.createObjectURL(file);
  img.onload=function(){var r=Math.min(1,1600/Math.max(img.width,img.height)),c=document.createElement('canvas');c.width=Math.round(img.width*r);c.height=Math.round(img.height*r);c.getContext('2d').drawImage(img,0,0,c.width,c.height);URL.revokeObjectURL(u);c.toBlob(cb,'image/jpeg',0.82)};
  img.onerror=function(){URL.revokeObjectURL(u);cb(null)};img.src=u;
}
function fmsg(m){$('fmsg').textContent=m}
$('fotos').addEventListener('change',function(e){
  var f=e.target.files&&e.target.files[0];if(!f)return;
  var k=e.target.closest('.foto').dataset.k;
  photos[k]=f;renderFotos();fmsg('Foto cargada ('+Math.round(f.size/1024)+' KB)');
  comprimir(f,function(bl){if(bl&&bl.size<f.size&&photos[k]===f){photos[k]=bl;renderFotos();fmsg('Foto lista ('+Math.round(bl.size/1024)+' KB)')}});
});
$('fotos').addEventListener('click',function(e){
  if(!e.target.classList.contains('del'))return;
  delete photos[e.target.closest('.foto').dataset.k];renderFotos();
});
$('wa').addEventListener('click',function(){
  var t=build();
  var files=FOTOS.filter(function(f){return photos[f[0]]}).map(function(f){return new File([photos[f[0]]],f[2]+'.jpg',{type:'image/jpeg'})});
  if(files.length&&navigator.canShare&&navigator.canShare({files:files})){
    navigator.share({files:files,text:t}).catch(function(err){if(err&&err.name!=='AbortError')flash('No se pudo compartir')});
    return;
  }
  window.open('https://wa.me/?text='+encodeURIComponent(t),'_blank');
  if(files.length)flash('Acá no se pueden adjuntar fotos: mandá el texto y adjuntalas en el chat');
});
$('cp').addEventListener('click',function(){
  var t=build();
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(function(){flash('Mensaje copiado')},function(){flash('No se pudo copiar')})}
  else{var a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();try{document.execCommand('copy');flash('Mensaje copiado')}catch(e){flash('No se pudo copiar')}a.remove()}
});
$('nw').addEventListener('click',function(){
  if(!confirm('¿Borrar los números, litros y barrios para empezar un nuevo día?'))return;
  S.n={P:0,V:0,R:0};S.c=[0,0,0,0,0];S.litros='';S.descarga='';S.barrios='';S.otroTxt='';
  ['litros','descarga','barrios','otroTxt'].forEach(function(i){$(i).value=''});
  [].forEach.call(document.querySelectorAll('#srv input[data-g]'),function(i){i.value=0});
  photos={};renderFotos();refresh();
});
marcaTurno();renderFotos();build();
</script>
</body>
</html>
